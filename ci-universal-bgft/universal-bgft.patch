+    data class TextResponse(val code: Int, val body: String)
+
+    fun postJson(url: String, json: String, maxBytes: Int = 128 * 1024): TextResponse {
+        require(maxBytes in 1..1024 * 1024) { "Resposta JSON deve ter entre 1 byte e 1 MiB" }
+        val endpoint = requireHttpUrl(url)
+        val body = json.toByteArray(StandardCharsets.UTF_8)
+        val conn = (URL(endpoint).openConnection() as HttpURLConnection).apply {
+            instanceFollowRedirects = true
+            connectTimeout = 15000
+            readTimeout = 15000
+            requestMethod = "POST"
+            doOutput = true
+            setRequestProperty("User-Agent", DIRECT_UA)
+            setRequestProperty("Accept", "application/json")
+            setRequestProperty("Content-Type", "application/json; charset=utf-8")
+            setFixedLengthStreamingMode(body.size)
+        }
+        conn.outputStream.use { it.write(body) }
+        val code = conn.responseCode
+        val stream = try { conn.inputStream } catch (_: Exception) { conn.errorStream }
+        val out = ByteArrayOutputStream()
+        if (stream != null) {
+            val buf = ByteArray(4096)
+            stream.use {
+                while (out.size() < maxBytes) {
+                    val n = it.read(buf, 0, minOf(buf.size, maxBytes - out.size()))
+                    if (n <= 0) break
+                    out.write(buf, 0, n)
+                }
+            }
+        }
+        conn.disconnect()
+        return TextResponse(code, out.toString("UTF-8"))
+    }
+
     fun postForm(url: String, fields: Map<String, String>, maxBytes: Int = 128 * 1024): String {
         val endpoint = requireHttpUrl(url)
         val body = fields.entries.joinToString("&") {
