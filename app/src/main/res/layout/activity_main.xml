<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/ic_launcher_background"
                android:contentDescription="@string/app_name"
                android:padding="4dp"
                android:src="@drawable/ic_launcher_foreground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="AKIRABOX"
                android:textColor="@color/akira_text"
                android:textSize="19sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/networkStatus"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_status"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="● Pronto"
                android:textColor="@color/akira_green"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:letterSpacing="0.05"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="PLAYSTATION 4 E PLAYSTATION 5"
                android:textColor="@color/akira_accent_bright"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="1dp"
                android:text="@string/hero_title"
                android:textColor="@color/akira_text"
                android:textSize="24sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/hero_subtitle"
                android:textColor="@color/akira_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:checkedButton="@id/modePkg"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modePkg"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/mode_pkg"
                android:textAllCaps="false"
                android:textColor="@color/toggle_text"
                app:backgroundTint="@color/toggle_background"
                app:cornerRadius="8dp"
                app:strokeColor="@color/toggle_stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modePayload"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/mode_payload"
                android:textAllCaps="false"
                android:textColor="@color/toggle_text"
                app:backgroundTint="@color/toggle_background"
                app:cornerRadius="8dp"
                app:strokeColor="@color/toggle_stroke" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/stepConsole"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_weight="1"
                android:background="@drawable/bg_step_active"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="①\nConsole"
                android:textColor="@color/akira_accent_bright"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/stepLink"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_step_idle"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="②\nLink"
                android:textColor="@color/akira_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/stepValidate"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_step_idle"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="③\nValidar"
                android:textColor="@color/akira_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/stepSend"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_step_idle"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="④\nEnvio"
                android:textColor="@color/akira_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:text="CONFIGURAÇÃO"
                android:textColor="@color/akira_accent_bright"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="Conecte ao seu console"
                android:textColor="@color/akira_text"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="Informe o console e o link direto do arquivo que deseja enviar."
                android:textColor="@color/akira_muted"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/consoleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:checkedButton="@id/consolePs4"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/consolePs4"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/console_ps4"
                    android:textAllCaps="false"
                    android:textColor="@color/toggle_text"
                    android:textSize="12sp"
                    app:backgroundTint="@color/toggle_background"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/toggle_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/consolePs5"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/console_ps5"
                    android:textAllCaps="false"
                    android:textColor="@color/toggle_text"
                    android:textSize="12sp"
                    app:backgroundTint="@color/toggle_background"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/toggle_stroke" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/modeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_hint"
                android:lineSpacingExtra="2dp"
                android:padding="12dp"
                android:text="Abra o Remote Package Installer/DPI no console • porta padrão 12800"
                android:textColor="@color/akira_muted"
                android:textSize="11sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ipLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/console_ip"
                app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/consoleIp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="0123456789."
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:textColor="@color/akira_text"
                    android:textColorHint="@color/akira_muted" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/urlLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/download_url"
                app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/downloadUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="2"
                    android:textColor="@color/akira_text"
                    android:textColorHint="@color/akira_muted" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/payloadSourceActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/payloadCatalogButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="@string/payload_catalog"
                    android:textAllCaps="false"
                    android:textColor="@color/akira_text"
                    android:textSize="11sp"
                    app:backgroundTint="@color/akira_transparent"
                    app:cornerRadius="9dp"
                    app:strokeColor="@color/akira_accent_line" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/choosePayloadFileButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="@string/choose_payload_file"
                    android:textAllCaps="false"
                    android:textColor="@color/akira_text"
                    android:textSize="11sp"
                    app:backgroundTint="@color/akira_transparent"
                    app:cornerRadius="9dp"
                    app:strokeColor="@color/akira_line" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/selectedFileCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_hint"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="6dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/selectedFileLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:maxLines="2"
                    android:textColor="@color/akira_text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/clearSelectedFile"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp"
                    android:text="@string/remove_file"
                    android:textColor="@color/akira_error"
                    android:textSize="10sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pasteUrlButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:text="@string/paste_link"
                android:textAllCaps="false"
                android:textColor="@color/akira_accent_bright"
                android:textSize="11sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/portLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:hint="@string/port">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/port"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="5"
                    android:maxLines="1"
                    android:text="12800"
                    android:textColor="@color/akira_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/trustedPayload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/trusted_payload"
                android:textColor="@color/akira_muted"
                android:textSize="12sp"
                android:visibility="gone"
                app:buttonTint="@color/akira_accent" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="14dp"
                android:indeterminateTint="@color/akira_accent_bright"
                android:max="100"
                android:progressTint="@color/akira_accent_bright"
                android:visibility="gone" />

            <TextView
                android:id="@+id/progressLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="@color/akira_muted"
                android:textSize="10sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/testButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:text="@string/test_connection"
                    android:textAllCaps="false"
                    android:textColor="@color/akira_text"
                    android:textSize="12sp"
                    app:backgroundTint="@color/akira_transparent"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/akira_line" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sendButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:text="@string/send"
                    android:textAllCaps="false"
                    android:textColor="@color/akira_primary_ink"
                    android:textSize="12sp"
                    app:backgroundTint="@color/akira_accent_bright"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_log"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="›  Atividade"
                    android:textColor="@color/akira_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/copyLog"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp"
                    android:text="@string/copy_log"
                    android:textColor="@color/akira_accent_bright"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/clearLog"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/clear_log"
                    android:textColor="@color/akira_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/akira_line" />

            <TextView
                android:id="@+id/logView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:minHeight="140dp"
                android:padding="16dp"
                android:text="--:--  INFO  Pronto para configurar o console."
                android:textColor="@color/akira_muted"
                android:textIsSelectable="true"
                android:textSize="10sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/helpButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/help_support"
            android:textAllCaps="false"
            android:textColor="@color/akira_text"
            app:backgroundTint="@color/akira_transparent"
            app:cornerRadius="8dp"
            app:strokeColor="@color/akira_line" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Akirabox • Android 7+ • ARMv7 e ARM64\nUse somente arquivos compatíveis com seu firmware."
            android:textColor="@color/akira_muted"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
