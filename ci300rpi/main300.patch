+    private fun sendSmart(info: PkgInfo) {
+        val host = ipInput.text.toString().trim()
+        if (host.isBlank()) { toast("Informe o IP do PS4"); return }
+        savePrefs()
+        setBusy(true, "One-Tap: procurando Remote Package Installer :12800/:11200…")
+        executor.execute {
+            try {
+                val fresh = try { PkgScanner.scan(info.finalUrl, info.requestContext) } catch (_: Exception) { info }
+                pkgInfo = fresh
+                val rpi = RpiClient.install(host, listOf(fresh.finalUrl))
+                rpiPort = rpi.port
+                rpiTaskId = rpi.taskId
+                runOnUiThread {
+                    setBusy(false)
+                    status.text = buildString {
+                        append("✓ Enviado pelo Remote Package Installer :${rpi.port}.")
+                        rpi.taskId?.let { append(" • Task $it") }
+                        append("\nO PS4 baixa diretamente da Internet; o celular não fica no caminho dos dados.")
+                    }
+                    rpiStatus.text = buildString {
+                        append("RPI :${rpi.port} • HTTP ${rpi.httpCode}")
+                        rpi.taskId?.let { append(" • Task $it") }
+                        if (rpi.taskId == null) append("\nO servidor aceitou o envio, mas não retornou Task ID no corpo da resposta.")
+                    }
+                    details.text = details.text.toString() + "\nModo escolhido: Remote Package Installer :${rpi.port}"
+                    if (rpi.taskId != null) startRpiMonitoring()
+                }
+            } catch (rpiError: Exception) {
+                runOnUiThread { status.text = "RPI indisponível/recusou. Tentando Payload BGFT :${BgftPayloadClient.PORT}…" }
+                try {
+                    val result = BgftPayloadClient.send(this, host, info)
+                    runOnUiThread {
+                        setBusy(false)
+                        status.text = buildString {
+                            append("✓ Fallback Payload enviado ao PS4 (${result.bytesSent} bytes).\n")
+                            append("RPI não estava disponível; o payload registrará o PKG no BGFT e encerrará.")
+                        }
+                        rpiStatus.text = "RPI não utilizado: ${rpiError.message}"
+                        details.text = details.text.toString() + "\nModo escolhido: Payload BGFT fallback :${BgftPayloadClient.PORT}"
+                    }
+                } catch (payloadError: Exception) {
+                    runOnUiThread {
+                        setBusy(false)
+                        status.text = "Falharam RPI e Payload. RPI: ${rpiError.message} • Payload: ${payloadError.message}"
+                    }
+                }
+            }
+        }
+    }
+
+    private fun testRpi() {
+        val host = ipInput.text.toString().trim()
+        if (host.isBlank()) { toast("Informe o IP do PS4"); return }
+        setBusy(true, "Testando Remote Package Installer…")
+        executor.execute {
+            try {
+                val result = RpiClient.probe(host)
+                rpiPort = result.port
+                runOnUiThread {
+                    setBusy(false)
+                    rpiStatus.text = "✓ RPI respondeu em $host:${result.port}. Pronto para receber /api/install."
+                }
+            } catch (e: Exception) {
+                runOnUiThread { setBusy(false); rpiStatus.text = "RPI indisponível: ${e.message}" }
+            }
+        }
+    }
+
+    private fun toggleRpiMonitoring() {
+        if (rpiMonitoring) stopRpiMonitoring() else startRpiMonitoring()
+    }
+
+    private fun startRpiMonitoring() {
+        if (rpiTaskId == null || rpiPort == null) {
+            toast("Nenhuma Task ID do RPI disponível")
+            return
+        }
+        rpiMonitoring = true
+        updateRpiMonitorButton()
+        if (activityResumed) {
+            monitorHandler.removeCallbacks(rpiMonitorTick)
+            monitorHandler.post(rpiMonitorTick)
+        }
+    }
+
+    private fun stopRpiMonitoring() {
+        rpiMonitoring = false
+        monitorHandler.removeCallbacks(rpiMonitorTick)
+        updateRpiMonitorButton()
+    }
+
+    private fun updateRpiMonitorButton() {
+        if (::rpiMonitorButton.isInitialized) rpiMonitorButton.text = if (rpiMonitoring) "PARAR RPI" else "MONITORAR RPI"
+    }
+
+    private val rpiMonitorTick = object : Runnable {
+        override fun run() {
+            if (!rpiMonitoring || !activityResumed) return
+            refreshRpiProgress(false)
+            monitorHandler.postDelayed(this, MONITOR_INTERVAL_MS)
+        }
+    }
+
+    private fun refreshRpiProgress(manual: Boolean) {
+        val host = ipInput.text.toString().trim()
+        val port = rpiPort
+        val task = rpiTaskId
+        if (host.isBlank() || port == null || task == null) {
+            if (manual) toast("Nenhuma tarefa RPI disponível")
+            return
+        }
+        if (rpiMonitorInFlight) return
+        rpiMonitorInFlight = true
+        executor.execute {
+            try {
+                val p = RpiClient.progress(host, port, task)
+                val pct = if (p.totalBytes > 0) (p.downloadedBytes * 100.0 / p.totalBytes).coerceIn(0.0, 100.0) else null
+                runOnUiThread {
+                    rpiMonitorInFlight = false
+                    rpiStatus.text = buildString {
+                        append("RPI :$port • Task ${p.taskId}")
+                        p.status?.let { append(" • $it") }
+                        if (p.totalBytes > 0) {
+                            append("\n${Format.bytes(p.downloadedBytes)} / ${Format.bytes(p.totalBytes)}")
+                            pct?.let { append(" • ${"%.1f".format(it)}%") }
+                        }
+                    }
+                }
+            } catch (e: Exception) {
+                runOnUiThread {
+                    rpiMonitorInFlight = false
+                    rpiStatus.text = "Monitoramento RPI indisponível: ${e.message}"
+                }
+            }
+        }
+    }
+
+    private fun controlRpi(action: String) {
+        val host = ipInput.text.toString().trim()
+        val port = rpiPort
+        val task = rpiTaskId
+        if (host.isBlank() || port == null || task == null) { toast("Nenhuma Task ID do RPI disponível"); return }
+        executor.execute {
+            try {
+                when (action) {
+                    "pause" -> RpiClient.pause(host, port, task)
+                    "resume" -> RpiClient.resume(host, port, task)
+                    "cancel" -> RpiClient.cancel(host, port, task)
+                }
+                runOnUiThread {
+                    rpiStatus.text = when (action) {
+                        "pause" -> "RPI Task $task pausada."
+                        "resume" -> "RPI Task $task retomada."
+                        else -> "RPI Task $task cancelada/removida."
+                    }
+                    if (action == "cancel") {
+                        stopRpiMonitoring()
+                        rpiTaskId = null
+                    }
+                }
+            } catch (e: Exception) {
+                runOnUiThread { rpiStatus.text = "Falha no comando RPI: ${e.message}" }
+            }
+        }
+    }
